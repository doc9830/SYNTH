# ─────────────────────────────────────────────────────────────
# Только для backend proxy (server/). НИКОГДА не попадает в frontend bundle.
# Файл .env в .gitignore — ключи в Git не коммитятся.
# ─────────────────────────────────────────────────────────────

# Порт локального backend proxy
PORT=8787

# ── Подключение к API (любой OpenAI-совместимый провайдер) ──
# Примеры base URL:
#   https://api.openai.com/v1        (OpenAI)
#   https://openrouter.ai/api/v1     (OpenRouter)
#   https://api.deepseek.com/v1      (DeepSeek)
#   https://www.ruapi.ai/v1          (RuAPI)
#   http://localhost:11434/v1        (Ollama локально)
PROVIDER_BASE_URL=https://api.openai.com/v1
PROVIDER_API_KEY=sk-your-api-key
# Необязательно: модель по умолчанию для proxy-режима
PROVIDER_MODEL=

# Устаревшие имена (поддерживаются для совместимости):
# RUAPI_BASE_URL, RUAPI_API_KEY, RUAPI_MODEL

# Web Search (Этап 2).
# Без ключей: keyless — бесплатный поиск (Bing RSS → DuckDuckGo → Wikipedia), значение по умолчанию.
# С ключом:  tavily | brave  (нужен SEARCH_API_KEY)
# Свой:      searxng         (нужен SEARCH_BASE_URL)
SEARCH_PROVIDER=keyless
# Движок бесплатного поиска: auto | bing | duckduckgo | wikipedia
SEARCH_ENGINE=auto
SEARCH_API_KEY=
# Для self-hosted SearXNG: адрес инстанса, например http://localhost:8080
SEARCH_BASE_URL=

# Чтение страниц по ссылке (read_url) и скриншоты (POST /api/page).
# Chrome/Chromium обычно находится сам (google-chrome, chromium, Edge, macOS-путь).
# Если браузер в нестандартном месте — укажите путь явно:
# CHROME_PATH=/usr/bin/google-chrome

# Image generation
# provider: images-api  (модель через POST /v1/images/generations: gpt-image-1, dall-e-3, flux)
#           chat-image  (модель рисует через POST /v1/chat/completions: gemini-2.5-flash-image)
IMAGE_PROVIDER=images-api
IMAGE_MODEL=gpt-image-1

# Опционально: разрешить браузеру обращаться к proxy с других origin
CORS_ORIGIN=*
